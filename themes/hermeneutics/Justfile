WORKDIR := `pwd`
BLOGDIR := `echo "${HOME}/blog"`

dev:
    @hugo server -s exampleSite --themesDir ../.. --tlsAuto

ana:
    @hugo -s exampleSite --themesDir ../.. --templateMetrics --templateMetricsHints

sync:
    @cd ${HOME}/blog && git ls-files -z | rsync -avh --delete --files-from=- --from0 {{ BLOGDIR }}/ {{ WORKDIR }}/exampleSite
    @cd {{ WORKDIR }}

update:
    @nix flake update
